{
  "name": "@oddessentials/repo-standards",
  "private": false,
  "version": "6.0.0",
  "description": "Standards and CI filtering utilities for multi-stack repository governance.",
  "type": "module",
  "bin": {
    "repo-standards": "./dist/cli.js"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run validate:schema && tsx scripts/build.ts && tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "security": "npm audit --audit-level=high --omit=dev",
    "policy": "npm run deps:check && tsx scripts/env-guard.ts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "sync:version": "node scripts/sync-schema-version-pretest.cjs",
    "prepare": "husky",
    "postinstall": "git config core.hooksPath .husky || true",
    "ci": "npm run check && npm run sync:version && npm run test && npm run build",
    "generate:standards": "tsx scripts/generate-standards.ts",
    "validate:schema": "tsx scripts/validate-schema.ts",
    "verify": "npm run check && npm run test && npm run security && npm run policy && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.2",
    "@semantic-release/npm": "^9.0.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "coverage-v8": "^0.0.1-security",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.39.1",
    "eslint-plugin-security": "^3.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "semantic-release": "^24.2.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.7.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{js,cjs,ts,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{js,cjs,ts,mjs}": [
      "eslint --fix"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oddessentials/repo-standards.git"
  },
  "homepage": "https://github.com/oddessentials/repo-standards#readme",
  "bugs": {
    "url": "https://github.com/oddessentials/repo-standards/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config/*": "./dist/config/*",
    "./schema/*": "./dist/schema/*"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "scripts/"
  ]
}
