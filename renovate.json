{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "schedule": ["after 6am and before 9am on Monday"],
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "automerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "description": "Group all @oddessentials packages",
      "matchPackagePatterns": ["^@oddessentials/"],
      "groupName": "oddessentials",
      "automerge": false
    },
    {
      "description": "Auto-merge patch and minor updates for dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major versions require dashboard approval",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "breaking-change"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
